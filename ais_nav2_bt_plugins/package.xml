<?xml version="1.0"?>
<package format="3">
  <name>ais_nav2_bt_plugins</name>
  <version>0.1.0</version>
  <description>Behavior Tree plugin that extracts the next few goals from a list for Nav2.</description>

  <maintainer email="info@ais.com">AIS Navigation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>behaviortree_cpp_v3</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_behavior_tree plugin="share/ais_nav2_bt_plugins/plugin.xml"/>
  </export>
</package>
